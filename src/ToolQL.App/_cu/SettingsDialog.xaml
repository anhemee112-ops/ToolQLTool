<Window x:Class="ToolQL.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Jar của client (để vẽ ô lát của map)" Foreground="{StaticResource MutedBrush}"/>
        <DockPanel Margin="0,4,0,6">
            <Button DockPanel.Dock="Right" Content="Chọn..." Margin="8,0,0,0" Click="OnBrowse"/>
            <TextBox x:Name="JarBox"/>
        </DockPanel>
        <TextBlock Text="ToolQL không kèm jar. Để trống thì khung xem vẫn vẽ nhưng không có ô lát (chỉ ký hiệu trên nền xanh)."
                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="ErrorText" Foreground="#D33B3B" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" IsCancel="True" MinWidth="80"/>
            <Button Content="Lưu" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="0" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
