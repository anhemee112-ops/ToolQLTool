<Window x:Class="ToolQL.App.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Tên đăng nhập" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="UserBox" Margin="0,4,0,12"/>

        <TextBlock x:Name="PasswordLabel" Text="Mật khẩu" Foreground="{StaticResource MutedBrush}"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,12"/>

        <TextBlock Text="Server" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="ServerBox" Margin="0,4,0,12"/>

        <TextBlock Text="Ghi chú" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="NoteBox" Margin="0,4,0,12"/>

        <TextBlock x:Name="ErrorText" Foreground="#D33B3B" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" IsCancel="True" MinWidth="80"/>
            <Button x:Name="OkButton" Content="Lưu" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="0" Click="OnOk"/>
        </StackPanel>
        <TextBlock Text="Mật khẩu được mã hóa theo tài khoản Windows hiện tại (DPAPI); chép file sang máy hoặc user khác thì phải nhập lại."
                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
